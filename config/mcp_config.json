{
  "mcpServers": {
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_CONTEXT7_API_KEY"
      }
    },
    "podman-mcp": {
      "command": "bunx",
      "args": [
        "-y",
        "podman-mcp-server@latest"
      ],
      "env": {
        "PATH": "/opt/podman/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "CONTAINER_HOST": "unix:///Users/i/.local/share/containers/podman/machine/podman.sock"
      }
    },
    "git": {
      "command": "bunx",
      "args": [
        "mcp-git"
      ]
    },
    "memory": {
      "command": "bunx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "/Users/i/.gemini/memory.jsonl"
      }
    },
    "filesystem": {
      "command": "bunx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/i/work"
      ]
    },
    "k8s-mcp-server": {
      "command": "/Users/Shared/dev/bin/k8s-mcp-server",
      "args": [
        "--mode",
        "stdio"
      ],
      "env": {
        "KUBECONFIG": "~/.kube/config"
      }
    },
    "postman": {
      "command": "bunx",
      "args": [
        "-y",
        "@postman/postman-mcp-server@latest"
      ],
      "env": {
        "POSTMAN_API_KEY": "YOUR_POSTMAN_API_KEY"
      }
    },
    "jira": {
      "command": "bunx",
      "args": [
        "-y",
        "mcp-jira"
      ],
      "env": {
        "JIRA_BASE_URL": "https://your-domain.atlassian.net",
        "JIRA_HOST": "https://your-domain.atlassian.net",
        "JIRA_URL": "https://your-domain.atlassian.net",
        "JIRA_EMAIL": "your-email@example.com",
        "JIRA_USER_EMAIL": "your-email@example.com",
        "JIRA_API_TOKEN": "YOUR_JIRA_API_TOKEN",
        "JIRA_API_KEY": "YOUR_JIRA_API_KEY"
      }
    }
  }
}
